{
  "name": "reel-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plex-style video player for taking screenshots and trimming clips from a media library",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "icons": "node scripts/render-icons.mjs",
    "build:web": "npm --prefix web run build"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "lru-cache": "^11.5.2",
    "p-limit": "^7.3.2",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
